-- --- LOGIQUE COMPATIBLE DÉFORMATION ET PHYSIQUE ---
local function initialiserPhysiquePersonnage(character)
    -- On utilise xpcall pour intercepter et tracer précisément chaque erreur de logique
    local successInit, errInit = xpcall(function()
        local humanoid = character:WaitForChild("Humanoid", 8)
        local upperTorso = character:WaitForChild("UpperTorso", 8)
        
        if not humanoid then
            logMessage("Impossible de trouver l'Humanoid du personnage.", "attention")
            return
        end
        if not upperTorso then
            logMessage("Le torse supérieur (UpperTorso) est introuvable. Votre avatar n'est peut-être pas configuré en R15.", "attention")
            return
        end

        -- Création ou récupération des os d'enveloppe géométrique (Bones)
        local boneLeft = upperTorso:FindFirstChild("Delta_ChestBone_L")
        local boneRight = upperTorso:FindFirstChild("Delta_ChestBone_R")

        if not boneLeft then
            boneLeft = Instance.new("Bone")
            boneLeft.Name = "Delta_ChestBone_L"
            boneLeft.CFrame = CFrame.new(-0.35, 0.2, -0.4)
            boneLeft.Parent = upperTorso
            logMessage("Os gauche initialisé.", "info")
        end

        if not boneRight then
            boneRight = Instance.new("Bone")
            boneRight.Name = "Delta_ChestBone_R"
            boneRight.CFrame = CFrame.new(0.35, 0.2, -0.4)
            boneRight.Parent = upperTorso
            logMessage("Os droit initialisé.", "info")
        end

        -- WrapTarget pour l'interaction automatique avec les vêtements 3D
        local wrapTarget = upperTorso:FindFirstChildOfClass("WrapTarget")
        if not wrapTarget then
            wrapTarget = Instance.new("WrapTarget")
            wrapTarget.Parent = upperTorso
            logMessage("WrapTarget généré pour l'adaptation des vêtements.", "info")
        end

        wrapTarget.Stiffness = 0.5   -- Adaptation serrée du tissu aux courbes
        wrapTarget.Inflation = 0.08  -- Évite le clipping de texture

        -- Reconstruction du Rig pour appliquer les modifications physiques de l'avatar
        local successBuild, errBuild = pcall(function()
            humanoid:BuildRigFromAttachments()
        end)
        if not successBuild then
            logMessage("BuildRigFromAttachments a échoué (souvent bloqué par l'anti-cheat du jeu ou non pris en charge) : " .. tostring(errBuild), "attention")
        end

        -- Variables de simulation physique locale
        local lastPosition = upperTorso.Position
        local velocity = Vector3.new(0, 0, 0)
        local currentOffset = 0

        -- Boucle d'oscillation fluide
        local connection
        connection = RunService.RenderStepped:Connect(function()
            -- Vérifier si le personnage existe toujours dans la scène de jeu
            if not character or not character:IsDescendantOf(workspace) or not upperTorso:IsDescendantOf(workspace) then
                connection:Disconnect()
                logMessage("Personnage détruit ou téléporté hors de la map. Boucle de physique arrêtée.", "info")
                return
            end

            -- Encapsulation de la boucle de rendu pour éviter qu'une erreur répétitive ne fasse crasher Delta
            local successRender, errRender = pcall(function()
                if PhysicsEnabled then
                    local currentPosition = upperTorso.Position
                    local movement = currentPosition - lastPosition
                    lastPosition = currentPosition

                    -- Algorithme de ressort physique léger
                    velocity = (velocity * 0.85) - (movement * JIGGLE_BOUNCE)
                    currentOffset = math.clamp(currentOffset + velocity.Y, -0.15, 0.15)

                    -- Application des déformations locales sur les os
                    boneLeft.Transform = CFrame.new(0, currentOffset, -CHEST_DEPTH) * CFrame.fromEulerAnglesXYZ(currentOffset * 0.5, 0, 0)
                    boneRight.Transform = CFrame.new(0, currentOffset, -CHEST_DEPTH) * CFrame.fromEulerAnglesXYZ(currentOffset * 0.5, 0, 0)
                    
                    -- Mise à l'échelle des volumes
                    local scaleL = boneLeft:FindFirstChild("Scale") or Instance.new("Vector3Value", boneLeft)
                    scaleL.Name = "Scale"
                    scaleL.Value = Vector3.new(CHEST_SCALE, CHEST_SCALE, CHEST_DEPTH)

                    local scaleR = boneRight:FindFirstChild("Scale") or Instance.new("Vector3Value", boneRight)
                    scaleR.Name = "Scale"
                    scaleR.Value = Vector3.new(CHEST_SCALE, CHEST_SCALE, CHEST_DEPTH)
                else
                    boneLeft.Transform = CFrame.new(0, 0, -CHEST_DEPTH)
                    boneRight.Transform = CFrame.new(0, 0, -CHEST_DEPTH)
                end
            end)

            if not successRender then
                connection:Disconnect()
                logMessage("Erreur critique dans la boucle RenderStepped : " .. tostring(errRender), "erreur")
            end
        end)

    end, function(errorMessage)
        -- Retourne le message d'erreur d'initialisation ainsi que sa stack trace complète
        return errorMessage .. "\n" .. debug.traceback()
    end)

    if not successInit then
        logMessage("Échec de l'initialisation physique sur l'avatar : " .. tostring(errInit), "erreur")
    end
end

