local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TestService = game:GetService("TestService") -- Permet d'écrire en couleur dans la console Roblox
local LocalPlayer = Players.LocalPlayer

-- Paramètres généraux
local CHEST_DEPTH = 1.35
local CHEST_SCALE = 1.25
local JIGGLE_BOUNCE = 0.08
local PhysicsEnabled = true

-- --- FONCTION DE LOG ET DE GESTION DES ERREURS ---
-- Écrit les messages importants et les erreurs dans la console de Delta et de Roblox
local function logMessage(message, typeLog)
    local prefix = "[Physique-Delta] "
    if typeLog == "erreur" then
        -- Écrit en rouge dans la console d'erreur standard de Roblox et dans Delta
        TestService:Error(prefix .. "ERREUR DETECTEE : " .. tostring(message))
        warn(prefix .. "Traceback d'erreur : " .. debug.traceback())
    elseif typeLog == "attention" then
        warn(prefix .. "ATTENTION : " .. tostring(message))
    else
        print(prefix .. "INFO : " .. tostring(message))
    end
end

