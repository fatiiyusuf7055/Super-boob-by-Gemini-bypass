-- --- LOGIQUE APPLICATIVE ---
local function initialiserPhysique(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local upperTorso = character:WaitForChild("UpperTorso", 10)
    
    if not humanoid or not upperTorso then 
        warn("[Physique-Delta] R15 UpperTorso non détecté.")
        return 
    end

    -- Initialisation des os de déformation de l'avatar
    local boneLeft = upperTorso:FindFirstChild("Delta_ChestBone_L") or Instance.new("Bone")
    if not boneLeft.Parent then
        boneLeft.Name = "Delta_ChestBone_L"
        boneLeft.CFrame = CFrame.new(-0.35, 0.2, -0.4)
        boneLeft.Parent = upperTorso
    end

    local boneRight = upperTorso:FindFirstChild("Delta_ChestBone_R") or Instance.new("Bone")
    if not boneRight.Parent then
        boneRight.Name = "Delta_ChestBone_R"
        boneRight.CFrame = CFrame.new(0.35, 0.2, -0.4)
        boneRight.Parent = upperTorso
    end

    -- WrapTarget pour relier dynamiquement les vêtements 3D (Layered Clothing)
    local wrapTarget = upperTorso:FindFirstChildOfClass("WrapTarget") or Instance.new("WrapTarget")
    if not wrapTarget.Parent then
        wrapTarget.Parent = upperTorso
    end
    wrapTarget.Stiffness = 0.5
    wrapTarget.Inflation = 0.08

    -- Force la mise à jour de l'assemblage géométrique
    pcall(function()
        humanoid:BuildRigFromAttachments()
    end)

    -- Variables de simulation d'inertie
    local lastPosition = upperTorso.Position
    local velocity = Vector3.new(0, 0, 0)
    local currentOffset = 0

    -- Boucle d'oscillation synchrone avec l'affichage
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not character or not character:IsDescendantOf(workspace) or not upperTorso:IsDescendantOf(workspace) then
            connection:Disconnect()
            return
        end

        pcall(function()
            if PhysicsEnabled then
                local currentPosition = upperTorso.Position
                local movement = currentPosition - lastPosition
                lastPosition = currentPosition

                -- Calcul du rebond physique
                velocity = (velocity * 0.85) - (movement * JIGGLE_BOUNCE)
                currentOffset = math.clamp(currentOffset + velocity.Y, -0.15, 0.15)

                -- Déformation et mise à l'échelle des os
                boneLeft.Transform = CFrame.new(0, currentOffset, -CHEST_DEPTH) * CFrame.fromEulerAnglesXYZ(currentOffset * 0.5, 0, 0)
                boneRight.Transform = CFrame.new(0, currentOffset, -CHEST_DEPTH) * CFrame.fromEulerAnglesXYZ(currentOffset * 0.5, 0, 0)
                
                local scaleL = boneLeft:FindFirstChild("Scale") or Instance.new("Vector3Value", boneLeft)
                scaleL.Name = "Scale"
                scaleL.Value = Vector3.new(CHEST_SCALE, CHEST_SCALE, CHEST_DEPTH)

                local scaleR = boneRight:FindFirstChild("Scale") or Instance.new("Vector3Value", boneRight)
                scaleR.Name = "Scale"
                scaleR.Value = Vector3.new(CHEST_SCALE, CHEST_SCALE, CHEST_DEPTH)
            else
                -- Position de repos par défaut
                boneLeft.Transform = CFrame.new(0, 0, -CHEST_DEPTH)
                boneRight.Transform = CFrame.new(0, 0, -CHEST_DEPTH)
            end
        end)
    end)
end

-- Écouteur de réapparition
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1.5)
    initialiserPhysique(char)
end)

if LocalPlayer.Character then
    task.spawn(function()
        initialiserPhysique(LocalPlayer.Character)
    end)
end

